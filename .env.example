# =============================================
# Segurança
# =============================================
# Token obrigatório para autenticação do cliente no servidor MCP.
APP_API_KEY=change-this-to-a-strong-random-token

# =============================================
# Redis (cache)
# =============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================
# Métricas
# =============================================
METRICS_HOST=0.0.0.0
METRICS_PORT=9100

# TTL de cache das respostas em segundos.
CACHE_TTL_SECONDS=300

# Transporte MCP (stdio para local, streamable-http para docker/k8s)
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
